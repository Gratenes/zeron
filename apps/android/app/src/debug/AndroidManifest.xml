<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug only: `adb shell am broadcast -a sh.zeron.android.PHONE_WAKE` stands in for the push. -->
        <receiver
            android:name="sh.zeron.android.phone.PhoneWakeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="sh.zeron.android.PHONE_WAKE" />
            </intent-filter>
        </receiver>
        <receiver android:name="sh.zeron.android.phone.PhoneTestSmsReceiver" android:exported="true">
            <intent-filter>
                <action android:name="sh.zeron.android.TEST_SMS" />
            </intent-filter>
        </receiver>
        <receiver android:name="sh.zeron.android.phone.PhoneTestChatReceiver" android:exported="true">
            <intent-filter><action android:name="sh.zeron.android.TEST_CHAT" /></intent-filter>
        </receiver>
        <receiver android:name="sh.zeron.android.phone.PhoneTestReplyReceiver" android:exported="false">
            <intent-filter><action android:name="sh.zeron.android.TEST_CHAT_REPLY" /></intent-filter>
        </receiver>
        <receiver android:name="sh.zeron.android.phone.PhoneTestPinReceiver" android:exported="true">
            <intent-filter><action android:name="sh.zeron.android.TEST_PIN" /></intent-filter>
        </receiver>
        <receiver android:name="sh.zeron.android.phone.PhoneTestFolderReceiver" android:exported="true">
            <intent-filter><action android:name="sh.zeron.android.TEST_FOLDER" /></intent-filter>
        </receiver>
    </application>
</manifest>
